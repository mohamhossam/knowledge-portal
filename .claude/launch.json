{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "knowledge-api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "knowledge_portal.interfaces.api.serve", "--host", "127.0.0.1", "--port", "8100"],
      "port": 8100,
      "env": {
        "LLM_PROVIDER": "fake",
        "PERSISTENCE_PROVIDER": "memory",
        "IDENTITY_PROVIDER": "fake",
        "LIBRARY_SCAN_MODE": "offline",
        "PROVIDER_RATE_LIMIT_PER_MINUTE": "0"
      }
    },
    {
      "name": "knowledge-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend"],
      "port": 5174,
      "url": "http://localhost:5174"
    },
    {
      "name": "redesign-api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "knowledge_portal.interfaces.api.serve", "--host", "127.0.0.1", "--port", "8110"],
      "port": 8110,
      "env": {
        "LLM_PROVIDER": "fake",
        "PERSISTENCE_PROVIDER": "memory",
        "IDENTITY_PROVIDER": "fake",
        "LIBRARY_SCAN_MODE": "offline",
        "PROVIDER_RATE_LIMIT_PER_MINUTE": "0"
      }
    },
    {
      "name": "redesign-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend", "--", "--port", "5184"],
      "port": 5184,
      "url": "http://localhost:5184",
      "env": { "KNOWLEDGE_API_PORT": "8110" }
    },
    {
      "name": "catalogue-api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "knowledge_portal.interfaces.api.serve", "--host", "127.0.0.1", "--port", "8120"],
      "port": 8120,
      "env": {
        "LLM_PROVIDER": "fake",
        "PERSISTENCE_PROVIDER": "memory",
        "IDENTITY_PROVIDER": "fake",
        "LIBRARY_SCAN_MODE": "offline",
        "PROVIDER_RATE_LIMIT_PER_MINUTE": "0"
      }
    },
    {
      "name": "catalogue-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend", "--", "--port", "5194"],
      "port": 5194,
      "url": "http://localhost:5194",
      "env": { "KNOWLEDGE_API_PORT": "8120" }
    }
  ]
}
