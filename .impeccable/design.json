  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The page's one main action: maroon fill, white text, near-square.",
      "html": "<button class=\"ds-btn-primary\">Publish and put in service</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;min-height:32px;padding:0 12px;border:1px solid var(--color-action,#4b0f1e);border-radius:2px;background:var(--color-action-fill,#4b0f1e);color:var(--color-on-action-fill,#fff);font:500 15px/1.2 'Archivo Variable',system-ui,sans-serif;cursor:pointer}.ds-btn-primary:hover{background:var(--color-action-fill-hover,#6a1a2d)}.ds-btn-primary:focus-visible{outline:2px solid var(--color-focus,#4b0f1e);outline-offset:2px;box-shadow:0 0 0 4px var(--color-surface,#fff)}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Every other action: white, strong rule, maroon on hover.",
      "html": "<button class=\"ds-btn-secondary\">Save review</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;min-height:32px;padding:0 12px;border:1px solid var(--color-rule-strong,#8a8579);border-radius:2px;background:var(--color-surface,#fff);color:var(--color-ink,#1f1b1a);font:500 15px/1.2 'Archivo Variable',system-ui,sans-serif;cursor:pointer}.ds-btn-secondary:hover{border-color:var(--color-action,#4b0f1e)}.ds-btn-secondary:focus-visible{outline:2px solid var(--color-focus,#4b0f1e);outline-offset:2px}"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "A destructive verb with its object: rust with an icon, never brand red.",
      "html": "<button class=\"ds-btn-danger\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z\"/><path d=\"M12 9v4M12 17h.01\"/></svg>Withdraw 'XGPON coverage rules'</button>",
      "css": ".ds-btn-danger{display:inline-flex;gap:8px;align-items:center;min-height:32px;padding:0 12px;border:1px solid var(--color-danger,#8c3a1f);border-radius:2px;background:var(--color-danger,#8c3a1f);color:var(--color-on-danger,#fff);font:500 15px/1.2 'Archivo Variable',system-ui,sans-serif;cursor:pointer}.ds-btn-danger:focus-visible{outline:2px solid var(--color-focus,#4b0f1e);outline-offset:2px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "field",
      "description": "Visible label, hint under it, own text direction.",
      "html": "<label class=\"ds-field\"><span class=\"ds-field-label\">Why exclude it?</span><span class=\"ds-field-hint\">The document's reviewers see this.</span><input class=\"ds-field-input\" dir=\"auto\" placeholder=\"Internal floor price\"></label>",
      "css": ".ds-field{display:grid;gap:4px;max-width:28rem;font:15px/1.45 'Archivo Variable',system-ui,sans-serif;color:var(--color-ink,#1f1b1a)}.ds-field-label{font-weight:600}.ds-field-hint{font-size:14px;color:var(--color-ink-2,#4a4542)}.ds-field-input{min-height:32px;padding:4px 8px;border:1px solid var(--color-rule-strong,#8a8579);border-radius:2px;background:var(--color-surface,#fff);color:inherit;font:inherit}.ds-field-input:focus-visible{outline:2px solid var(--color-focus,#4b0f1e);outline-offset:2px}"
    },
    {
      "name": "Rail Navigation",
