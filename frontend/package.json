{
  "name": "knowledge-portal-ui",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:brand": "node scripts/brand-lint.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "e2e": "playwright test",
    "api:generate": "openapi-typescript ../contracts/knowledge-public.openapi.json -o src/api/schema.d.ts",
    "api:check": "node scripts/check-openapi-types.mjs",
    "budget": "node scripts/bundle-budget.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.2.8",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.2.8",
    "@tanstack/react-query": "^5.104.0",
    "lucide-react": "^1.48.0",
    "oidc-client-ts": "~3.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vitest-axe": "^0.1.0"
  }
}
