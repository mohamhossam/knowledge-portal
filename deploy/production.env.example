# The knowledge portal's settings for deploy/compose.production.yaml.
# Copy to deploy/production.env (git-ignored) and fill in every blank.
# The manifest itself sets PERSISTENCE_PROVIDER, DATABASE_URL, the scanner,
# LOG_FORMAT=json and the metrics exporter. Every other variable is documented
# in .env.example.

APP_ENV=production

# Identity. Curation needs the knowledge_admin role; the explorer is open to
# anyone signed in (ADR-0101). deploy/keycloak/apply.py adds
# this client, its audience and the roles to the realm (deployment.md, "Sign-in").
IDENTITY_PROVIDER=oidc
OIDC_ISSUER_URL=
OIDC_AUDIENCE=knowledge-api
OIDC_CLIENT_ID=knowledge-spa

# Models for library search, catalogue reading and architecture matching.
# The manifest mounts the host directory KNOWLEDGE_LLM_CONFIG_DIR (default: this
# repository's config/) read-only at /app/config; set it where you run docker
# compose, not here.
LLM_PROVIDER=
# OPENAI_API_KEY=
# LLM_CONFIG_PATH=/app/config/llm.yaml
# GEMINI_API_KEY=

# Architecture matching uses the models chosen above. Set this to true only
# after the bilingual architecture evaluation passes on those models;
# production refuses to start without it.
KNOWLEDGE_EVALUATION_APPROVED=false

# Local model context. Reading architecture documents for catalogue suggestions
# splits each document to fit what is left for input (window minus output).
# LOCAL_LLM_CONTEXT_WINDOW_TOKENS=16384
# LOCAL_LLM_MAX_OUTPUT_TOKENS=8192

# The apps that read the knowledge base through /knowledge-api/apps/v2 (ADR-0126).
# Leave both empty and the app API is not served. Each app is registered by its
# client at the issuer, whose tokens for the audience knowledge-apps are admitted
# (comma-separated client ids), or by a token of its own, 32+ characters
# (comma-separated name=token pairs; prefer clients through the public address).
# docs/operations/deployment.md, "Register an app".
APP_CLIENT_IDS=
APP_TOKENS=

# Cost guard per actor per API replica.
PROVIDER_RATE_LIMIT_PER_MINUTE=30
LOG_LEVEL=INFO
